{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values for the volveran chart",
  "description": "Validated by helm install, upgrade, lint and template. The template guards in templates/_helpers.tpl give the readable refusals (replicaCount, ADR 0003).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "description": "Must be 1 (docs/adr/0003-single-replica-on-kubernetes.md). The chart refuses any other value with that explanation.",
      "type": "integer"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "description": "Pins the image by digest; overrides tag.",
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "description": "Names of existing image pull Secrets.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "description": "Required. The OIDC issuer URL; https unless on loopback."
        },
        "clientId": {
          "type": "string",
          "description": "Required."
        },
        "redirectUrl": {
          "type": "string",
          "description": "Required. The public callback URL; its path ends in /auth/callback."
        },
        "scopes": {
          "type": "string",
          "minLength": 1
        },
        "groupsClaim": {
          "type": "string",
          "minLength": 1,
          "description": "The ID token claim holding the Operator's groups, for Roles."
        },
        "existingSecret": {
          "type": "string",
          "description": "Required. An existing Secret holding the OIDC client secret and the session secret."
        },
        "clientSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "sessionSecretKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "issuer, clientId, redirectUrl and existingSecret are required. The chart refuses a missing one with a message naming it (templates/_helpers.tpl), which a schema error cannot carry."
    },
    "brokerProfiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "description": "Broker Profiles in the same shape as the profiles YAML. Passwords are never written here: passwordEnv names a key of passwordsSecret.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/brokerProfile"
          }
        },
        "alertDestinations": {
          "description": "Alert Destinations in the same shape as the profiles YAML. URLs and signing secrets are never written here: urlEnv and signingSecretEnv name keys of alerts.existingSecret.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/alertDestination"
          }
        },
        "passwordsSecret": {
          "type": "string"
        },
        "existingConfigMap": {
          "description": "An existing ConfigMap with a profiles.yaml key, used instead of profiles.",
          "type": "string"
        }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "description": "An existing Secret whose keys become environment variables: the Alert Destinations' URLs and signing secrets.",
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        }
      }
    },
    "caBundles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundles": {
          "description": "Existing ConfigMaps or Secrets mounted read-only at /etc/volveran/ca/<name>. Exactly one of configMap or secret, and unique DNS-label names, are checked by templates/_helpers.tpl.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "configMap": {
                "type": "string",
                "minLength": 1
              },
              "secret": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "oidcTrust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bundle": {
              "description": "The name of one of bundles; its key is set as NODE_EXTRA_CA_CERTS.",
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "false uses an emptyDir: Audit Entries and Discarded Message bodies are lost on every restart.",
          "type": "boolean"
        },
        "existingClaim": {
          "description": "An existing PersistentVolumeClaim used instead of a chart-created one.",
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod",
            "ReadWriteMany"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "httpRoute": {
      "description": "An optional Gateway API HTTPRoute to the Service at the root of each host name. Required-ness when enabled is checked in templates/httproute.yaml.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "sectionName": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "group": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ingress": {
      "description": "An optional Ingress to the Service at the root of each host. Required-ness when enabled is checked in templates/ingress.yaml.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "secretName"
            ],
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Sets VOLVERAN_METRICS_PORT and adds the container port and a metrics Service port.",
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "description": "A Prometheus Operator ServiceMonitor. Requires metrics.enabled, checked in templates/_helpers.tpl.",
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "interval": {
              "description": "A Prometheus duration such as 30s; empty uses Prometheus's scrape_interval.",
              "type": "string",
              "pattern": "^(([0-9]+(ms|s|m|h|d|w|y))+)?$"
            },
            "scrapeTimeout": {
              "description": "A Prometheus duration such as 10s; empty uses Prometheus's scrape_timeout.",
              "type": "string",
              "pattern": "^(([0-9]+(ms|s|m|h|d|w|y))+)?$"
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkoutMaxMessages": {
          "description": "VOLVERAN_CHECKOUT_MAX_MESSAGES; null leaves Volverán's default (1000).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "checkoutMaxMb": {
          "description": "VOLVERAN_CHECKOUT_MAX_MB; null leaves Volverán's default (100).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000
        },
        "checkoutTimeLimitMinutes": {
          "description": "VOLVERAN_CHECKOUT_TIME_LIMIT_MINUTES; null leaves Volverán's default (30).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1440
        },
        "checkoutHeartbeatSeconds": {
          "description": "VOLVERAN_CHECKOUT_HEARTBEAT_SECONDS; null leaves Volverán's default (120).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 10,
          "maximum": 3600
        },
        "bodyRetentionDays": {
          "description": "VOLVERAN_BODY_RETENTION_DAYS; null leaves Volverán's default (30).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 36500
        },
        "bodyRetentionMaxBytes": {
          "description": "VOLVERAN_BODY_RETENTION_MAX_BYTES: bytes, or a whole number with KiB, MiB, GiB or TiB; null leaves Volverán's default (1GiB).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[0-9]+ *([KkMmGgTt][Ii][Bb]|[Bb])?$"
            }
          ]
        },
        "bodyRetentionIntervalMinutes": {
          "description": "VOLVERAN_BODY_RETENTION_INTERVAL_MINUTES; null leaves Volverán's default (60).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1440
        },
        "historyIntervalSeconds": {
          "description": "VOLVERAN_HISTORY_INTERVAL_SECONDS; null leaves Volverán's default (60).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 15,
          "maximum": 3600
        },
        "historyRetentionDays": {
          "description": "VOLVERAN_HISTORY_RETENTION_DAYS; null leaves Volverán's default (14).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 90
        }
      }
    },
    "extraEnv": {
      "description": "Extra container environment variables. The chart refuses a variable it sets itself (templates/_helpers.tpl).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        }
      }
    },
    "pod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Added to the pod's labels. The selector labels (app.kubernetes.io/name, app.kubernetes.io/instance) are refused."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "description": "NetworkPolicy peers admitted to the http port.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/networkPolicyPeer"
          }
        },
        "metricsFrom": {
          "description": "NetworkPolicy peers admitted to the metrics port only, when metrics.enabled.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/networkPolicyPeer"
          }
        },
        "egress": {
          "description": "NetworkPolicy egress rules. Any rule restricts egress to these rules plus DNS to dnsTo.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/networkPolicyPeer"
                }
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "port": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    },
                    "endPort": {
                      "type": "integer"
                    },
                    "protocol": {
                      "enum": [
                        "TCP",
                        "UDP",
                        "SCTP"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "dnsTo": {
          "description": "NetworkPolicy peers of the cluster DNS resolver, allowed on port 53 whenever egress is restricted.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/networkPolicyPeer"
          }
        }
      }
    }
  },
  "definitions": {
    "alertDuration": {
      "type": "string",
      "pattern": "^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
      "minLength": 2
    },
    "brokerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "managementUrl",
        "amqpUrl"
      ],
      "if": {
        "required": [
          "credentials"
        ],
        "properties": {
          "credentials": {
            "const": "operatorToken"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "username"
              ]
            },
            {
              "required": [
                "passwordEnv"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "username",
          "passwordEnv"
        ],
        "not": {
          "required": [
            "tokenUsernameClaim"
          ]
        }
      },
      "properties": {
        "credentials": {
          "description": "shared (default): username and the password from passwordEnv. operatorToken (Team Mode only): each signed-in Operator's own OAuth 2.0 access token, without username or passwordEnv.",
          "enum": [
            "shared",
            "operatorToken"
          ]
        },
        "tokenUsernameClaim": {
          "description": "Only with credentials: operatorToken. The access token claim the broker uses as the user name, recorded as the broker user in Audit Entries. Default sub.",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "managementUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "amqpUrl": {
          "type": "string",
          "pattern": "^amqps?://"
        },
        "caFile": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "passwordEnv": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "vhosts": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "defaultQueueFilter": {
          "type": "string"
        },
        "protected": {
          "type": "boolean"
        },
        "requireApproval": {
          "description": "Only with protected: true (Volverán refuses it otherwise). Default true: an Apply waits for a second Operator's Approval.",
          "type": "boolean"
        },
        "replayRate": {
          "description": "The Replay Rate in Messages per second (0.1 to 1000): default, the rate an Apply runs at when the Operator gives none; max, the most an Operator may choose. Volverán refuses default above max.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "default": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1000
            },
            "max": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1000
            }
          }
        },
        "canary": {
          "description": "Canary Replay: watchWindow, how long a Canary is watched for dying again, a duration from 5s to 10m (default 30s); Volverán checks the range at startup. requiredAbove: an Apply with more Replays than this must start with a Canary (default: never required).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "watchWindow": {
              "type": "string",
              "pattern": "^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
              "minLength": 2
            },
            "requiredAbove": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "roles": {
          "description": "Team Mode: the OIDC groups holding each Role on this profile. Without it, every signed-in Operator is admin.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "viewer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "operator": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "admin": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "alerts": {
          "description": "Alert Rules: tell an Alert Destination when a dead-letter queue is too deep, fills too fast or receives anything. Not allowed with credentials: operatorToken. Durations are a whole number and a unit (d, h, m, s). Volverán checks the ranges and destination names at startup.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "destinations", "when"],
            "properties": {
              "name": { "description": "Unique within the profile.", "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
              "destinations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "for": { "$ref": "#/definitions/alertDuration" },
              "repeatEvery": { "$ref": "#/definitions/alertDuration" },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "required": ["vhost"],
                "oneOf": [
                  { "required": ["queue"] },
                  { "required": ["queuePattern"] }
                ],
                "properties": {
                  "vhost": { "type": "string", "minLength": 1 },
                  "queue": { "type": "string", "minLength": 1 },
                  "queuePattern": { "description": "Glob on queue names (*, ?); each matching dead-letter queue is its own Alert.", "type": "string", "minLength": 1 },
                  "depthAbove": { "type": "integer", "minimum": 0 },
                  "arrivalsAbove": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["count", "within"],
                    "properties": {
                      "count": { "type": "integer", "minimum": 0 },
                      "within": { "$ref": "#/definitions/alertDuration" }
                    }
                  },
                  "anyArrival": { "const": true }
                }
              }
            }
          }
        },
        "replayRules": {
          "description": "Replay rules: which Messages of one dead-letter queue Volverán Replays automatically, how often and how many times. Not allowed with credentials: operatorToken. Durations are a whole number and a unit (d, h, m, s), e.g. 30s, 5m, 1h30m. Volverán checks the ranges at startup.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "vhost",
              "queue",
              "every",
              "backoff",
              "maxAttempts",
              "stopWhen"
            ],
            "properties": {
              "name": {
                "description": "Unique within the profile.",
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "vhost": {
                "type": "string",
                "minLength": 1
              },
              "queue": {
                "type": "string",
                "minLength": 1
              },
              "filter": {
                "description": "One filter clause, or a list of them, as in the API (e.g. { kind: x-death-reason, value: rejected }). Left out, every Message.",
                "type": [
                  "object",
                  "array"
                ]
              },
              "every": {
                "description": "How often a pass runs: 30s to 24h.",
                "type": "string",
                "pattern": "^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
                "minLength": 2
              },
              "maxPerPass": {
                "description": "The most Messages one pass Replays (default 100, at most the Checkout Message limit).",
                "type": "integer",
                "minimum": 1
              },
              "rate": {
                "description": "The rule's Replay Rate in Messages per second (default 10, at most the profile's replayRate.max).",
                "type": "number",
                "minimum": 0.1,
                "maximum": 1000
              },
              "backoff": {
                "description": "The delay before attempt n: initial × multiplier^n, at most max.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "initial",
                  "max"
                ],
                "properties": {
                  "initial": {
                    "type": "string",
                    "pattern": "^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
                    "minLength": 2
                  },
                  "multiplier": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "max": {
                    "type": "string",
                    "pattern": "^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
                    "minLength": 2
                  }
                }
              },
              "maxAttempts": {
                "description": "The most attempts per Message, counted from its Died Again count.",
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "whenAttemptsUsedUp": {
                "description": "keep (default), or { moveTo: { queue } } to a parking queue other than the rule's queue.",
                "oneOf": [
                  {
                    "const": "keep"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "moveTo"
                    ],
                    "properties": {
                      "moveTo": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "queue"
                        ],
                        "properties": {
                          "queue": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "stopWhen": {
                "description": "Required: the rule pauses itself once diedAgain of the Messages it Replayed die again within the window.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "diedAgain",
                  "within"
                ],
                "properties": {
                  "diedAgain": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "within": {
                    "type": "string",
                    "pattern": "^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
                    "minLength": 2
                  }
                }
              },
              "startPaused": {
                "description": "Starts paused until an admin resumes it.",
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaceSelector": {
          "type": "object"
        },
        "podSelector": {
          "type": "object"
        },
        "ipBlock": {
          "type": "object"
        }
      }
    },
    "alertDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "urlEnv"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "type": {
          "enum": [
            "slack",
            "teams",
            "webhook"
          ]
        },
        "urlEnv": {
          "type": "string",
          "minLength": 1
        },
        "signingSecretEnv": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "webhook"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "signingSecretEnv"
          ]
        }
      }
    }
  }
}
