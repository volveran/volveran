{
  "name": "volveran",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:chart": "vitest run --config vitest.chart.config.ts",
    "test:broker": "node scripts/test-broker.mjs run -- vitest run --config vitest.broker-facts.config.ts",
    "test:integration": "node scripts/test-broker.mjs run -- vitest run --config vitest.integration.config.ts",
    "test:smoke": "node scripts/kind-smoke.mjs",
    "broker:up": "node scripts/test-broker.mjs up",
    "broker:down": "node scripts/test-broker.mjs down"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "amqplib": "^2.2.0",
    "fastify": "^5.12.7",
    "openid-client": "^6.8.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
